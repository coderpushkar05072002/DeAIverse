from flask import Flask, jsonify, request
from flask_cors import CORS
from web3 import Web3
import os

app = Flask(__name__)
CORS(app)

# ? Allow eval for localhost dev only (fixes blank screen due to CSP)
@app.after_request
def allow_dev_eval(response):
    host = request.host.split(':')[0]
    if host in ("127.0.0.1", "localhost"):
        response.headers['Content-Security-Policy'] = (
            "default-src 'self'; "
            "script-src 'self' 'unsafe-eval' 'unsafe-inline'; "
            "connect-src *; "
            "style-src 'self' 'unsafe-inline';"
        )
    return response

# ? Hardhat Local RPC URL
RPC_URL = os.getenv("RPC_URL", "http://127.0.0.1:8545")
w3 = Web3(Web3.HTTPProvider(RPC_URL))

# ? Contract addresses (local Hardhat deployment)
TOKEN_ADDR = os.getenv("TOKEN_ADDR", "0x5FbDB2315678afecb367f032d93F642f64180aa3")
MARKET_ADDR = os.getenv("MARKET_ADDR", "0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512")
SBT_ADDR = os.getenv("SBT_ADDR", "0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0")

# ?? Health Check
@app.route("/health")
def health():
    ok = w3.is_connected()
    try:
        coinbase = w3.eth.accounts[0] if ok else None
    except Exception:
        coinbase = None
    return jsonify({
        "ok": ok,
        "chainId": 1337,
        "coinbase": coinbase,
    })

# ?? Mock task storage (temporary in-memory)
tasks = [
    {
        "id": 1,
        "consumer": "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
        "provider": "0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC",
        "price": "1000000000000000000",
        "status": "Verified",
        "dataset": "ipfs://dataset-abc",
        "result": "ipfs://result-xyz",
    },
    {
        "id": 2,
        "consumer": "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
        "provider": "0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC",
        "price": "1000000000000000000",
        "status": "Verified",
        "dataset": "ipfs://dataset-abc",
        "result": "ipfs://result-xyz",
    }
]

# ?? List tasks
@app.route("/tasks", methods=["GET"])
def list_tasks():
    return jsonify(tasks)

# ? Create a new task
@app.route("/tasks", methods=["POST"])
def create_task():
    data = request.get_json(force=True)
    new_task = {
        "id": len(tasks) + 1,
        "consumer": data.get("consumer", ""),
        "provider": data.get("provider", ""),
        "price": data.get("price", "0"),
        "status": "Pending",
        "dataset": data.get("dataset", ""),
        "result": "",
    }
    tasks.append(new_task)
    return jsonify({"ok": True, "task": new_task})

# ? Mark task verified
@app.route("/tasks/<int:task_id>/verify", methods=["POST"])
def verify_task(task_id):
    for t in tasks:
        if t["id"] == task_id:
            t["status"] = "Verified"
            return jsonify({"ok": True, "task": t})
    return jsonify({"ok": False, "error": "Task not found"}), 404

# --- Development helper: remove any Content-Security-Policy header ---
@app.after_request
def remove_csp(response):
    try:
        if "Content-Security-Policy" in response.headers:
            del response.headers["Content-Security-Policy"]
    except Exception:
        pass
    return response
# ---------------------------------------------------------------------

from abi import MARKET_ABI

# ?? Test route: read totalJobs() from Market contract
@app.route("/test/market", methods=["GET"])
def test_market():
    if not w3.is_connected():
        return jsonify({"ok": False, "error": "Web3 not connected"}), 500

    try:
        market = w3.eth.contract(address=MARKET_ADDR, abi=MARKET_ABI)
        total_jobs = market.functions.totalJobs().call()
        return jsonify({
            "ok": True,
            "market": MARKET_ADDR,
            "totalJobs": int(total_jobs)
        })
    except Exception as e:
        return jsonify({"ok": False, "error": str(e)}), 500
    print("?? Backend running on http://127.0.0.1:5001")
    app.run(host="127.0.0.1", port=5001, debug=True)

if __name__ == '__main__':
    print("?? Backend running on http://127.0.0.1:5001")
    app.run(host="127.0.0.1", port=5001, debug=True)
